{
  "doctype": "DocType",
  "name": "WhatsApp Conversation",
  "module": "Whatsit",
  "engine": "InnoDB",
  "istable": 0,
  "field_order": [
    "conversation_section",
    "sender",
    "remote_number",
    "conversation_column",
    "status",
    "unread_count",
    "party_section",
    "party_type",
    "party_column",
    "party",
    "latest_message_section",
    "last_message_preview",
    "activity_section",
    "last_message_at",
    "last_incoming_at",
    "activity_column",
    "service_window_expires_at"
  ],
  "fields": [
    {
      "fieldname": "conversation_section",
      "fieldtype": "Section Break",
      "label": "Conversation"
    },
    {
      "fieldname": "sender",
      "label": "Sender",
      "fieldtype": "Link",
      "options": "WhatsApp Number",
      "reqd": 1,
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "remote_number",
      "label": "Recipient",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "read_only": 1,
      "length": 16
    },
    {
      "fieldname": "conversation_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nClosed",
      "default": "Open"
    },
    {
      "fieldname": "unread_count",
      "label": "Unread",
      "fieldtype": "Int",
      "read_only": 1,
      "default": 0,
      "non_negative": 1
    },
    {
      "fieldname": "party_section",
      "fieldtype": "Section Break",
      "label": "Party"
    },
    {
      "fieldname": "party_type",
      "label": "Party Type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1
    },
    {
      "fieldname": "party_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "party",
      "label": "Party",
      "fieldtype": "Dynamic Link",
      "options": "party_type",
      "read_only": 1,
      "depends_on": "eval:doc.party_type"
    },
    {
      "fieldname": "latest_message_section",
      "fieldtype": "Section Break",
      "label": "Last Message"
    },
    {
      "fieldname": "last_message_preview",
      "label": "Last Message",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "activity_section",
      "fieldtype": "Section Break",
      "label": "Activity"
    },
    {
      "fieldname": "last_message_at",
      "label": "Last Message",
      "fieldtype": "Datetime",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "last_incoming_at",
      "label": "Last Incoming",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "activity_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "service_window_expires_at",
      "label": "Reply Until",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "WhatsApp Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "WhatsApp Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    },
    {
      "role": "WhatsApp User",
      "read": 1,
      "select": 1
    },
    {
      "role": "WhatsApp API User",
      "read": 1,
      "select": 1
    }
  ],
  "track_changes": 0,
  "autoname": "hash"
}
