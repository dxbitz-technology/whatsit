{
  "doctype": "DocType",
  "name": "WhatsApp Webhook Event",
  "module": "Whatsit",
  "engine": "InnoDB",
  "istable": 0,
  "field_order": [
    "received_at",
    "meta_app",
    "event_key",
    "event_type",
    "payload",
    "processing_status",
    "attempt_count",
    "last_error",
    "processed_at",
    "next_attempt_at"
  ],
  "fields": [
    {
      "fieldname": "received_at",
      "label": "Received At",
      "fieldtype": "Datetime",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "meta_app",
      "label": "Meta App",
      "fieldtype": "Link",
      "options": "WhatsApp Meta App",
      "reqd": 1
    },
    {
      "fieldname": "event_key",
      "label": "Event Key",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "event_type",
      "label": "Event Type",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "payload",
      "label": "Payload",
      "fieldtype": "Code",
      "options": "JSON",
      "permlevel": 1
    },
    {
      "fieldname": "processing_status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Queued\nProcessing\nProcessed\nFailed",
      "default": "Queued",
      "in_list_view": 1
    },
    {
      "fieldname": "attempt_count",
      "label": "Attempts",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "last_error",
      "label": "Error",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "processed_at",
      "label": "Processed At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "next_attempt_at",
      "label": "Next Attempt",
      "fieldtype": "Datetime"
    }
  ],
  "permissions": [
    {
      "role": "WhatsApp Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "WhatsApp Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    }
  ],
  "track_changes": 0,
  "autoname": "hash"
}
