{
  "doctype": "DocType",
  "name": "WhatsApp Template",
  "module": "Whatsit",
  "engine": "InnoDB",
  "istable": 0,
  "field_order": [
    "waba_id",
    "sender",
    "meta_template_id",
    "template_name",
    "language",
    "category",
    "header_type",
    "header_text",
    "header_sample_handle",
    "body",
    "footer",
    "variables",
    "buttons",
    "status",
    "rejection_reason",
    "quality_rating",
    "last_synced_at",
    "last_submitted_at",
    "meta_response"
  ],
  "fields": [
    {
      "fieldname": "waba_id",
      "label": "Business Account ID",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sender",
      "label": "Sender",
      "fieldtype": "Link",
      "options": "WhatsApp Number"
    },
    {
      "fieldname": "meta_template_id",
      "label": "Meta Template ID",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "template_name",
      "label": "Template Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "language",
      "label": "Language",
      "fieldtype": "Data",
      "default": "en",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "UTILITY\nMARKETING\nAUTHENTICATION",
      "default": "UTILITY",
      "reqd": 1
    },
    {
      "fieldname": "header_type",
      "label": "Header",
      "fieldtype": "Select",
      "options": "NONE\nTEXT\nIMAGE\nDOCUMENT",
      "default": "NONE"
    },
    {
      "fieldname": "header_text",
      "label": "Header Text",
      "fieldtype": "Data"
    },
    {
      "fieldname": "header_sample_handle",
      "label": "Media Sample Handle",
      "fieldtype": "Data"
    },
    {
      "fieldname": "body",
      "label": "Body",
      "fieldtype": "Text",
      "reqd": 1
    },
    {
      "fieldname": "footer",
      "label": "Footer",
      "fieldtype": "Data"
    },
    {
      "fieldname": "variables",
      "label": "Variables",
      "fieldtype": "Table",
      "options": "WhatsApp Template Variable"
    },
    {
      "fieldname": "buttons",
      "label": "Buttons",
      "fieldtype": "Table",
      "options": "WhatsApp Template Button"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Data",
      "read_only": 1,
      "default": "DRAFT",
      "in_list_view": 1
    },
    {
      "fieldname": "rejection_reason",
      "label": "Rejection Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "quality_rating",
      "label": "Quality",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "last_synced_at",
      "label": "Last Synced",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_submitted_at",
      "label": "Last Submitted",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "meta_response",
      "label": "Meta Response",
      "fieldtype": "Code",
      "read_only": 1,
      "options": "JSON",
      "permlevel": 1
    }
  ],
  "permissions": [
    {
      "role": "WhatsApp Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "WhatsApp Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    },
    {
      "role": "WhatsApp User",
      "read": 1,
      "select": 1
    },
    {
      "role": "WhatsApp API User",
      "read": 1,
      "select": 1
    }
  ],
  "track_changes": 0,
  "autoname": "hash",
  "title_field": "template_name"
}
